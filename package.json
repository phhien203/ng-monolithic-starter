{
  "name": "ng-monolithic-starter",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" package.json angular.json components.json tsconfig*.json README.md .prettierrc",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" package.json angular.json components.json tsconfig*.json README.md .prettierrc",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "@ng-icons/core": "32.5.0",
    "@ng-icons/lucide": "32.5.0",
    "@sentry/angular": "10.69.0",
    "@sentry/cli": "2.58.6",
    "@spartan-ng/brain": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-angular": "22.0.0",
    "ngx-scrollbar": "19.1.5",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.6.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.1.0",
    "@angular/build": "22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "@eslint/js": "10.0.1",
    "@spartan-ng/cli": "1.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "angular-eslint": "22.1.0",
    "eslint": "10.8.0",
    "jsdom": "28.1.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.0"
  }
